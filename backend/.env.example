# Salin file ini menjadi backend/.env (atau set sebagai environment variable)
# Kunci enkripsi password akun — WAJIB di produksi. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TRADING_SECRET_KEY=

# Token API (opsional tapi DISARANKAN bila backend terpapar internet):
TRADING_API_TOKEN=

# Aktifkan CORS bila frontend di-host terpisah (mis. GitHub Pages):
TRADING_CORS=0

# (Windows saja) Path terminal MT5, contoh:
# TRADING_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
TRADING_MT5_PATH=

# ------------------------------------------------------------------
# MT5 Socket Bridge (read-only) — lihat docs/MT5-BRIDGE.md
# Aktifkan hanya bila perlu; default MATI.
MT5_BRIDGE_ENABLED=0
# Alamat bind server bridge. Biarkan 127.0.0.1 kecuali tahu risikonya.
MT5_BRIDGE_HOST=127.0.0.1
# Port server bridge (EA MT5 akan menyambung ke port ini).
MT5_BRIDGE_PORT=1111
